{
  "name": "avansat-monorepo",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "pnpm --filter avansat-risk dev",
    "dev:falsa": "pnpm --filter @avansat/api-falsa dev",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "infra:up": "docker compose -f infra/compose.yaml up -d",
    "infra:down": "docker compose -f infra/compose.yaml down"
  }
}
